$ORIGIN example.test.
$TTL 3600
@         IN SOA   ns1.example.test. hostmaster.example.test. 1 7200 900 1209600 300
@         IN NS    ns1.example.test.
ns1       IN A     192.0.2.53
@         IN MX    10 mail.example.test.
mail      IN CNAME mx.provider.invalid.
@         IN CAA   0 issue "ca.example"
@         IN CAA   128 tbs "x"
www       IN CNAME web.provider.invalid.
www       IN TXT   "v=verify"
sub       IN NS    ns.sub.example.test.
alias     IN HTTPS 0 svc.provider.invalid.
old       IN DNAME new.example.test.
